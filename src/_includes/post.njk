---
layout: base.njk
---
{% from "icons.njk" import icon %}

<article class="post-article">
  <header class="post-head">
    <div class="container container--narrow">
      {% if category %}
        <a class="badge badge--inline" href="/posts/?category={{ category | urlencode }}">{{ category }}</a>
      {% endif %}
      <h1 class="post-title">{{ title }}</h1>
      <p class="post-meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        {% if author %}
          <span class="post-meta__sep" aria-hidden="true">&bull;</span>
          <span>By {{ author }}</span>
        {% endif %}
      </p>
      {% if cover %}
        <div class="post-cover">
          <img src="{{ cover }}" alt="{{ title }}" />
        </div>
      {% endif %}
    </div>
  </header>

  <div class="container container--narrow">
    <div class="prose">
      {{ content | safe }}
    </div>

    <footer class="post-foot">
      <a class="btn btn--ghost" href="/posts/">
        ← Back to all posts
      </a>
      <div class="post-share">
        <span class="post-share__label">Share</span>
        <a class="social-link"
           href="https://wa.me/?text={{ title | urlencode }}%20{{ site.url }}{{ page.url | urlencode }}"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Share on WhatsApp">
          {{ icon("whatsapp", 16) }}
        </a>
        <a class="social-link"
           href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ site.url }}{{ page.url | urlencode }}"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Share on X">
          {{ icon("x", 16) }}
        </a>
      </div>
    </footer>
  </div>
</article>
