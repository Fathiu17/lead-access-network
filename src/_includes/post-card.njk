<article class="post-card" data-category="{{ post.data.category }}">
  <a class="post-card__link" href="{{ post.url }}">
    <div class="post-card__media">
      <img
        class="post-card__img"
        src="{{ post.data.cover or '/images/uploads/placeholder.svg' }}"
        alt="{{ post.data.title }}"
        loading="lazy" />
      {% if post.data.category %}
        <span class="badge">{{ post.data.category }}</span>
      {% endif %}
    </div>
    <div class="post-card__body">
      <p class="post-card__meta">
        <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
      </p>
      <h3 class="post-card__title">{{ post.data.title }}</h3>
      {% if post.data.excerpt %}
        <p class="post-card__excerpt">{{ post.data.excerpt }}</p>
      {% endif %}
      <span class="post-card__cta">Read Article</span>
    </div>
  </a>
</article>
